# Public URL of the jalanMY API, HTTPS required on Android.
# Includes search, reports, routing and speed-limit service. No secrets here.
VITE_API_URL=
# Production raster tile provider template. Keep required provider attribution.
VITE_TILE_URL=
# RM0 option: use these three public settings instead of VITE_API_URL.
VITE_GEOAPIFY_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
